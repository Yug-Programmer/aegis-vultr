# ============================================================================
# AEGIS // VULTR — Centralized Agent Control Plane & Sandbox Configuration
# ============================================================================

# --- 1. Vultr Serverless Inference (Primary LLM Control Layer) ---
# Endpoint: https://api.vultrinference.com/v1
VULTR_INFERENCE_API_KEY=
VULTR_INFERENCE_BASE_URL=https://api.vultrinference.com/v1
VULTR_INFERENCE_MODEL=kimi-k2-instruct

# --- 2. Vultr Cloud Compute API v2 (Sandbox VM Provisioning & Telemetry) ---
# Endpoint: https://api.vultr.com/v2
VULTR_API_KEY=
VULTR_DEFAULT_REGION=ewr
VULTR_DEFAULT_PLAN=vc2-2c-4gb

# --- 3. Optional Alternative OpenAI-Compatible LLM Providers ---
# Supported LLM_PROVIDER values: auto | vultr | gemini | openai
LLM_PROVIDER=auto
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# --- 4. Control Plane <-> Isolated Sandbox Worker RPC Security ---
CONTROL_PLANE_PORT=4000
SANDBOX_WORKER_PORT=4100
SANDBOX_WORKER_URL=http://127.0.0.1:4100
SANDBOX_SHARED_SECRET=aegis-vultr-dev-hmac-secret-change-in-prod

# --- 5. Sandbox Containment Driver ---
# auto: selects hardened Docker/gVisor on Vultr Linux VMs, or isolated zero-secret ephemeral workspace locally
# docker: forces Docker container isolation (--cap-drop=ALL --security-opt=no-new-privileges)
# local-isolated: sanitized ephemeral directory + zero-secret env + SSRF browser route guard
SANDBOX_DRIVER=auto
SANDBOX_DOCKER_IMAGE=aegis-sandbox-runner:latest
SANDBOX_DOCKER_RUNTIME=
SANDBOX_MAX_TIMEOUT_MS=25000
SANDBOX_METADATA_LABEL=vultr-sandbox-node-01
VULTR_INSTANCE_REGION=local-dev
