# Centralized Control Plane + Production Mission Control Web Application
FROM node:22-bookworm-slim

WORKDIR /app

COPY package.json tsconfig.base.json ./
COPY packages/shared ./packages/shared
COPY apps/control-plane ./apps/control-plane
COPY apps/web ./apps/web

RUN npm install \
  && npm --workspace=@aegis/shared run build \
  && npm --workspace=@aegis/control-plane run build \
  && npm --workspace=@aegis/web run build

EXPOSE 4000
CMD ["node", "apps/control-plane/dist/server.js"]
